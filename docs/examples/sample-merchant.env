# Sample merchant build environment for Cartaisy branded-build verification.
# Every value here is fictional and non-secret. Do not put real merchant
# values, credentials, or production identifiers in this file.
#
# Usage (from the repo root):
#   set -a; source docs/examples/sample-merchant.env; set +a
#   npx expo config --type public
#
# Values exported in the shell take precedence over the local .env file,
# so this can be verified without editing .env.

# --- Native build identity (consumed by app.config.ts) ---
APP_NAME="Acme Outfitters"
APP_SLUG=acme-outfitters
APP_SCHEME=acmeoutfitters
APP_VERSION=1.2.0
IOS_BUNDLE_IDENTIFIER=com.example.acmeoutfitters
IOS_BUILD_NUMBER=12
IOS_APPLE_PAY_MERCHANT_ID=merchant.com.example.acmeoutfitters
ANDROID_PACKAGE=com.example.acmeoutfitters
ANDROID_VERSION_CODE=12

# Real merchant builds must supply merchant-specific Firebase files that
# match the merchant bundle ID/package. The checked-in Cartaisy files are
# referenced here only so config evaluation works in this sample.
IOS_GOOGLE_SERVICES_FILE=./GoogleService-Info.plist
ANDROID_GOOGLE_SERVICES_FILE=./google-services.json

# Real merchant builds must supply merchant-approved icon/splash assets.
# APP_ICON_PATH is the web favicon only. The native launcher icon is
# ICON_IMAGE_PATH (repo file or EAS file env) or ICON_IMAGE_URL (public https,
# downloaded while app.config.ts evaluates, no auth header, not EXPO_PUBLIC_*).
# A missing file, a rejected URL, or a failed download resolves to
# assets/images/neutral-icon.png on a merchant build (no Cartaisy wordmark).
# This sample points at the square Acme placeholder. A real merchant can
# instead leave ICON_IMAGE_PATH unset and set ICON_IMAGE_URL.
APP_ICON_PATH=./assets/images/cartaisy-color-logo.png
ICON_IMAGE_PATH=./assets/images/acme-outfitters-logo.png
APP_NOTIFICATION_ICON_PATH=./assets/images/cartaisy-color-logo.png
APP_NOTIFICATION_COLOR=#1E90FF
# Merchant adaptive foreground. assets/images/adaptive-icon.png is the Cartaisy
# wordmark and is not used on a merchant build.
ANDROID_ADAPTIVE_ICON_PATH=./assets/images/acme-outfitters-adaptive-icon.png
ANDROID_ADAPTIVE_ICON_BACKGROUND=#0A2540
# Pre-JS native splash. This fictional public URL does not serve an image.
# app.config.ts fail-closes to assets/images/neutral-splash.png.
# A real merchant replaces it with their public https branding URL, or sets
# SPLASH_IMAGE_PATH to a repo path or an EAS file environment variable.
# Do not put Shopify tokens or other credentials in this URL, and do not
# copy it into an EXPO_PUBLIC_ variable.
SPLASH_IMAGE_URL=https://cdn.example.com/stores/acme-outfitters/splash.png
SPLASH_BACKGROUND_COLOR=#0A2540

# Internal sample EAS project created for GitHub issue #86. These values are
# non-secret metadata for @rendernext/acme-outfitters, separate from the
# default Cartaisy app project. Real merchant builds still need their own EAS
# project and owner decision.
EAS_PROJECT_ID=a9a1dd2e-adfe-4020-9f10-6b561859f119
EXPO_OWNER=rendernext

# --- Public runtime client configuration (bundled into JS) ---
EXPO_PUBLIC_API_BASE_URL=https://api.staging.example.com/api/v1
# Must be a 24-character hex Mongo ObjectId (validated case-insensitively by
# api/config/mobileConfig.ts, so real merchant ObjectIds work as-is).
EXPO_PUBLIC_STORE_ID=507f1f77bcf86cd799439011
EXPO_PUBLIC_APP_NAME="Acme Outfitters"
EXPO_PUBLIC_APP_SCHEME=acmeoutfitters
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample_placeholder
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.example.acmeoutfitters
